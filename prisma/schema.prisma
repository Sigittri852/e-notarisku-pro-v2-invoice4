generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Akta {
  id              String   @id @default(cuid())
  nomorAkta       String
  tanggal         String   @default("")
  kategori        String
  jenisAkta       String
  namaNotaris     String
  namaPihak       String
  nik             String?
  npwp            String?
  alamat          String?
  nomorSertifikat String?
  jenisHak        String?
  luasTanah       String?
  nilaiTransaksi  Float    @default(0)
  nopPbb          String?
  njop            Float    @default(0)
  tanggalSsp      String?
  sspPph          Float    @default(0)
  tanggalBphtb    String?
  bphtb           Float    @default(0)
  honorarium      Float    @default(0)
  status          String   @default("Draft")
  catatan         String?
  detailJson      String   @default("{}")
  pihakJson       String   @default("[]")
  dokumenJson     String   @default("[]")

  // Berkas & tanda tangan digital yang sebelumnya hanya tersimpan di data/akta.json.
  fotoTtdKlienJson        String @default("[]")
  fotoTtdNotarisJson      String @default("[]")
  minutaJson              String @default("[]")
  tandaTanganDigitalJson  String @default("[]")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}

model Invoice {
  id             String   @id @default(cuid())
  nomor          String   @unique
  tanggal        String
  jatuhTempo     String
  aktaId         String?
  nomorAkta      String?
  jenisAkta      String?
  kategori       String?
  namaNotaris    String?
  pelanggan      String
  alamat         String?
  nik            String?

  items          String   @default("[]")

  nilaiTransaksi Float    @default(0)
  njop           Float    @default(0)
  sspPph         Float    @default(0)
  sspdBphtb      Float    @default(0)

  diskon         Float    @default(0)
  ppnPersen      Float    @default(0)
  ppn            Float    @default(0)

  status         String   @default("Belum Lunas")
  catatan        String?
  metodePembayaran String?

  createdAt      String
  updatedAt      DateTime @updatedAt
}

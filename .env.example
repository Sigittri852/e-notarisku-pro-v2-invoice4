# Koneksi database PostgreSQL (jangan commit nilai asli)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Kunci penandatangan cookie sesi, minimal 32 karakter.
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# Akun administrator awal (dibuat saat data/users.json belum ada).
# Bila ADMIN_PASSWORD kosong, password acak dicetak ke log server saat pertama kali dijalankan.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@notaris.local
ADMIN_PASSWORD=

# Token Vercel Blob untuk upload dokumen
BLOB_READ_WRITE_TOKEN=
